# Normalise text to LF in the repository; Godot and gdtoolkit expect LF.
* text=auto eol=lf

# Godot text formats
*.gd           text eol=lf diff=python
*.tscn         text eol=lf
*.tres         text eol=lf
*.godot        text eol=lf
*.cfg          text eol=lf
*.import       text eol=lf
*.uid          text eol=lf
*.gdshader     text eol=lf
*.gdshaderinc  text eol=lf
*.csv          text eol=lf
*.gpl          text eol=lf
*.hex          text eol=lf
*.py           text eol=lf diff=python
*.sh           text eol=lf
*.md           text eol=lf diff=markdown
*.bat          text eol=crlf
*.cmd          text eol=crlf

