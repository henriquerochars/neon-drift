# Godot editor cache and imported asset data (regenerated by tools/godot.sh --headless --import)
.godot/
# Android build template installed by --install-android-build-template
/android/

# Local toolchain (pinned Godot binary, export templates)
/.tools

# Build and test outputs
build/
artifacts/

# Signing material must never be committed
*.keystore
*.jks
export_credentials.cfg

# Python tooling caches
__pycache__/
*.pyc
.venv/

# OS and editor noise
.DS_Store
Thumbs.db
*.swp
*~

# Never ignore *.import or *.uid: Godot needs them committed to keep UIDs and import settings stable.
reports/

# Agent worktrees created by the orchestrator tooling
.claude/worktrees/

# Shared AI harness local state (ADR 0007): locks, logs, gate receipts
.neondrift/
